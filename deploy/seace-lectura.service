[Unit]
Description=SEACE monitor: download, OCR and read the bases
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/seace-monitor-new
ExecStartPre=/usr/bin/docker compose --profile vpn up -d --wait db vpn
ExecStart=/usr/bin/docker compose --profile monitor run --rm monitor --lectura
