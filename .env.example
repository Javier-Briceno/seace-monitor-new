# Copy to .env and set your own values. .env is not committed.
POSTGRES_USER=seace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seace
# Host port for Postgres; 5433 avoids clashing with a local install on 5432.
POSTGRES_PORT=5433

# VPN (only with `docker compose --profile vpn`). Any provider gluetun supports
# that has servers in Peru; names and required credentials per provider:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Example values are for NordVPN, whose OpenVPN credentials are the "service
# credentials" from the Nord account page, not the login email and password.
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
# For VPN_TYPE=wireguard instead (untested):
WIREGUARD_PRIVATE_KEY=
VPN_COUNTRY=Peru
VPN_PROXY_PORT=8888
